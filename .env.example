# Environment variables for local development
# Copy this file to .env and fill in values as needed.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Responses API: none disables reasoning on supported models; blank uses provider defaults.
OPENAI_REASONING_EFFORT=none
# Vision model for corridor fire-risk assessment; defaults to deepseek-flash when blank.
OPENAI_VISION_MODEL=deepseek-flash
# Stable Fernet key for LangGraph checkpoints; export in process environment or pass to factory.
# Without it, an ephemeral key is used and old runs cannot resume after restart.
CHATBI_LANGCHAIN_CHECKPOINT_KEY=

# Redis —— 本地一般填 127.0.0.1（走 SSH 隧道转发到远端实例）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Kafka —— 走隧道时填 127.0.0.1:9092，且服务端 advertised.listeners 必须是同一地址
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# mmrag —— 多模态 RAG（本机跑接口/索引/问答，实例只跑 MinerU）
# 数据根目录；留空默认 <项目根>/data/mmrag
MMRAG_DATA_DIR=
# ~/.ssh/config 里的 Host 名，指向带 GPU 的实例
MMRAG_SSH_HOST=mmrag
# MinerU 4.x：档位与页范围（默认只解析前 10 页，长文档必须写 all）
MMRAG_MINERU_TIER=standard
MMRAG_MINERU_PAGES=all
# 问答模型是否支持图片输入；0 时用户图先 caption 再检索
MMRAG_LLM_SUPPORTS_VISION=0
MMRAG_TOP_K=8
MMRAG_MAX_IMAGES=3
MMRAG_KAFKA_GROUP=mmrag-worker
# 实例地址：只在 .env 里写一次，代码与图里都不留 IP
# （ssh 别名写在 ~/.ssh/config 的 Host 段里，这里留档便于换机器）
MMRAG_GPU_HOST=
# MinerU / 解析服务的 SSH 端口（控制台「ssh 登录指令」里那个）
MMRAG_SSH_PORT=22
# 本机 API 基地址：e2e 脚本与前端代理都从这里取，改端口不用改代码
MMRAG_API_BASE=http://127.0.0.1:8791
# 向量化：模型缓存与离线开关（国内直连 huggingface.co 会 60 秒超时重试 5 次）
MMRAG_EMBED_CACHE=
MMRAG_EMBED_OFFLINE=0
MMRAG_EMBED_ENDPOINT=https://hf-mirror.com
