# Environment variables for local development
# Copy this file to .env and fill in values as needed.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Responses API: none disables reasoning on supported models; blank uses provider defaults.
OPENAI_REASONING_EFFORT=none
# Vision model for corridor fire-risk assessment; defaults to deepseek-flash when blank.
OPENAI_VISION_MODEL=deepseek-flash
