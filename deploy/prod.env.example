# 云上（或任何用 docker 跑的地方）的配置模板。
#
#   cp prod.env.example prod.env
#   chmod 600 prod.env
#
# 这个文件只存在于宿主机，不进 git、不进镜像。
# 和本地 .env 的差别只有 REDIS_HOST 一项（compose 里已经覆盖成 redis），其余照抄。

# ---------------------------------------------------------------- 模型
SENSE_MODEL=deepseek-v4-pro
SENSE_TEMPERATURE=0.4
SENSE_RUNTIME=agents

# 判定 10 秒够（实测 2.3 秒），回应放宽到 45 秒：20 秒那次就是它触发的重试
SENSE_JUDGE_TIMEOUT=10
SENSE_REPLY_TIMEOUT=45
SENSE_MAX_ATTEMPTS=3

OPENAI_BASE_URL=https://api.deepseek.com
# 敏感：可以留空，改用 shell 里 export OPENAI_API_KEY 让 compose 展开
OPENAI_API_KEY=

# ---------------------------------------------------------------- Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# 敏感：和 compose 里 redis 的 --requirepass 必须一致
REDIS_PASSWORD=

# ---------------------------------------------------------------- 端口
SENSE_PORT=8800

# ---------------------------------------------------------------- 日志
SENSE_LOG_LEVEL=INFO
PYTHONIOENCODING=utf-8
